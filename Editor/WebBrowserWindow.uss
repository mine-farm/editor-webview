.web-browser-root {
    flex-grow: 1;
    background-color: #202124;
}

.web-browser-toolbar {
    height: 46px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: #202124;
}

.web-browser-navigation {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.web-browser-nav-button {
    width: 32px;
    height: 32px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    color: #bdc1c6;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    font-size: 17px;
}

.web-browser-nav-button:hover {
    color: #f1f3f4;
    background-color: #3c4043;
}

.web-browser-omnibox {
    height: 34px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
    background-color: #303134;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #3c4043;
    border-top-color: #3c4043;
    border-right-color: #3c4043;
    border-bottom-color: #3c4043;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.web-browser-omnibox:hover {
    background-color: #35363a;
}

.web-browser-site-badge {
    width: 32px;
    flex-shrink: 0;
    color: #9aa0a6;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.web-browser-address {
    height: 32px;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    color: #f1f3f4;
}

.web-browser-address > .unity-text-field__input,
.web-browser-address > .unity-base-text-field__input {
    color: #f1f3f4;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 4px;
    font-size: 12px;
}

.web-browser-bookmark-toggle,
.web-browser-go-button {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    color: #bdc1c6;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    font-size: 16px;
}

.web-browser-bookmark-toggle:hover,
.web-browser-go-button:hover {
    color: #f1f3f4;
    background-color: #4b4d51;
}

.web-browser-bookmark-toggle--active {
    color: #f6d365;
}

.web-browser-go-button {
    margin-right: 2px;
    font-size: 15px;
}

.web-browser-bookmark-bar {
    height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 3px 10px;
    background-color: #202124;
    border-bottom-width: 1px;
    border-bottom-color: #3c4043;
}

.web-browser-bookmark-icon {
    width: 28px;
    flex-shrink: 0;
    color: #9aa0a6;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.web-browser-bookmark-items {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.web-browser-bookmark-actions {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.web-browser-bookmark-entry {
    height: 28px;
    max-width: 190px;
    flex-direction: row;
    align-items: center;
    margin-right: 3px;
    padding-left: 7px;
    padding-right: 9px;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.web-browser-bookmark-entry:hover {
    background-color: #3c4043;
}

.web-browser-bookmark-entry-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 6px;
    color: #e8eaed;
    background-color: #4b4d51;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.web-browser-bookmark-entry-title {
    flex-grow: 1;
    flex-shrink: 1;
    color: #e8eaed;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.web-browser-bookmark-empty {
    color: #80868b;
    padding-left: 5px;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.web-browser-bookmark-folder {
    height: 28px;
    max-width: 180px;
    margin-right: 3px;
    padding-left: 9px;
    padding-right: 7px;
    color: #d8d8d8;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.web-browser-bookmark-folder:hover {
    background-color: #3c4043;
}

.web-browser-other-bookmarks {
    max-width: 160px;
    margin-right: 0;
}

.web-browser-content {
    flex-grow: 1;
}

.web-browser-status {
    height: 18px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-top: 2px;
    color: #9aa0a6;
    background-color: #202124;
    border-top-width: 1px;
    border-top-color: #3c4043;
    font-size: 10px;
}

.web-browser-status--hidden {
    display: none;
}

.bookmark-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    padding-top: 50px;
    padding-right: 10px;
    background-color: rgba(0, 0, 0, 0);
}

.bookmark-dialog-overlay--hidden {
    display: none;
}

.bookmark-dialog {
    width: 430px;
    padding: 14px;
    background-color: #202124;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #56585d;
    border-top-color: #56585d;
    border-right-color: #56585d;
    border-bottom-color: #56585d;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.bookmark-dialog-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.bookmark-dialog-title {
    flex-grow: 1;
    color: #f1f3f4;
    font-size: 16px;
    -unity-font-style: bold;
}

.bookmark-dialog-close {
    width: 28px;
    height: 28px;
    padding-left: 0;
    padding-right: 0;
    color: #c5c7cb;
    font-size: 20px;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.bookmark-dialog-close:hover {
    background-color: #35373b;
}

.bookmark-dialog-body {
    flex-direction: row;
    align-items: center;
}

.bookmark-dialog-preview {
    width: 102px;
    height: 102px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #0d0e10;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #55575c;
    border-top-color: #55575c;
    border-right-color: #55575c;
    border-bottom-color: #55575c;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.bookmark-dialog-preview-glyph {
    color: #f1f3f4;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bookmark-dialog-fields {
    flex-grow: 1;
    margin-left: 16px;
}

.bookmark-dialog-field-row {
    height: 42px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.bookmark-dialog-new-folder--hidden {
    display: none;
}

.bookmark-dialog-field-label {
    width: 42px;
    flex-shrink: 0;
    color: #f1f3f4;
    font-size: 12px;
}

.bookmark-dialog-input,
.bookmark-dialog-folder {
    height: 36px;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
}

.bookmark-dialog-input > .unity-text-field__input,
.bookmark-dialog-input > .unity-base-text-field__input,
.bookmark-dialog-folder > .unity-base-popup-field__input {
    color: #f1f3f4;
    background-color: #292a2d;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #73767c;
    border-top-color: #73767c;
    border-right-color: #73767c;
    border-bottom-color: #73767c;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.bookmark-dialog-input:focus > .unity-text-field__input,
.bookmark-dialog-input:focus > .unity-base-text-field__input,
.bookmark-dialog-folder:focus > .unity-base-popup-field__input {
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #9bb9ff;
    border-top-color: #9bb9ff;
    border-right-color: #9bb9ff;
    border-bottom-color: #9bb9ff;
}

.bookmark-dialog-footer {
    height: 48px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    margin-top: 10px;
}

.bookmark-dialog-button {
    height: 38px;
    min-width: 66px;
    margin-left: 10px;
    padding-left: 18px;
    padding-right: 18px;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
    font-size: 12px;
}

.bookmark-dialog-done {
    color: #172033;
    background-color: #a9c3ff;
}

.bookmark-dialog-done:hover {
    background-color: #bed2ff;
}

.bookmark-dialog-delete {
    color: #dbe9ff;
    background-color: #184f86;
}

.bookmark-dialog-delete:hover {
    background-color: #24639f;
}
