.web-browser-root {
    flex-grow: 1;
    background-color: #252525;
}

.web-browser-toolbar {
    height: 38px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    background-color: #303030;
    border-bottom-width: 1px;
    border-bottom-color: #191919;
}

.web-browser-nav-button {
    width: 32px;
    height: 28px;
    margin-right: 4px;
}

.web-browser-address {
    height: 28px;
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 4px;
}

.web-browser-bookmark-toggle {
    width: 32px;
    height: 28px;
    margin-right: 4px;
    color: #f2c94c;
    font-size: 16px;
}

.web-browser-go-button {
    width: 44px;
    height: 28px;
}

.web-browser-bookmark-bar {
    height: 30px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
    background-color: #303030;
    border-bottom-width: 1px;
    border-bottom-color: #191919;
}

.web-browser-bookmark-icon {
    width: 22px;
    flex-shrink: 0;
    color: #b8b8b8;
    -unity-text-align: middle-center;
}

.web-browser-bookmark-items {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.web-browser-bookmark-entry {
    height: 24px;
    max-width: 180px;
    margin-right: 3px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    color: #dedede;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.web-browser-bookmark-entry:hover {
    background-color: #474747;
}

.web-browser-bookmark-empty {
    color: #8f8f8f;
    padding-left: 4px;
    -unity-text-align: middle-left;
}

.web-browser-bookmark-rename {
    width: 140px;
    height: 24px;
    margin-right: 3px;
}

.web-browser-content {
    flex-grow: 1;
}

.web-browser-status {
    height: 22px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-top: 3px;
    color: #b8b8b8;
    background-color: #303030;
    border-top-width: 1px;
    border-top-color: #191919;
    font-size: 11px;
}
